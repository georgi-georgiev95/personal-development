rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    match /workspaces/{uid} {
      allow get: if request.auth != null &&
        request.auth.uid == uid &&
        (!exists(/databases/$(database)/documents/workspaces/$(uid)) ||
          resource.data.ownerUid == request.auth.uid);
      allow list: if false;
      allow create: if request.auth != null &&
        request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['ownerUid', 'createdAt']) &&
        request.resource.data.keys().hasAll(['ownerUid', 'createdAt']) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if false;

      function isWorkspaceOwner() {
        return request.auth != null &&
          request.auth.uid == uid &&
          exists(/databases/$(database)/documents/workspaces/$(uid)) &&
          get(/databases/$(database)/documents/workspaces/$(uid)).data.ownerUid == request.auth.uid;
      }

      function validEvidence(evidence) {
        return evidence.keys().hasOnly([
            'status', 'note', 'source', 'recordedAt', 'taskRevision', 'workRevision', 'revision'
          ]) &&
          evidence.keys().hasAll([
            'status', 'note', 'source', 'recordedAt', 'taskRevision', 'workRevision', 'revision'
          ]) &&
          evidence.status in ['passed', 'failed'] &&
          evidence.note is string &&
          (evidence.status == 'failed' || evidence.note.size() > 0) &&
          evidence.source in ['manual', 'ci'] &&
          evidence.recordedAt is string &&
          evidence.taskRevision is int && evidence.taskRevision > 0 &&
          evidence.workRevision is int && evidence.workRevision > 0 &&
          evidence.revision is int && evidence.revision > 0;
      }

      function validArtifact(artifact, stage, kind) {
        return artifact.keys().hasOnly([
            'stage', 'kind', 'content', 'source', 'revision', 'taskRevision', 'contextRevision', 'createdAt', 'updatedAt'
          ]) &&
          artifact.keys().hasAll([
            'stage', 'kind', 'content', 'source', 'revision', 'taskRevision', 'createdAt', 'updatedAt'
          ]) &&
          artifact.stage == stage &&
          artifact.kind == kind &&
          artifact.content is string &&
          artifact.source == 'manual' &&
          artifact.revision is int && artifact.revision > 0 &&
          artifact.taskRevision is int && artifact.taskRevision > 0 &&
          (!artifact.keys().hasAny(['contextRevision']) ||
            (artifact.contextRevision is int && artifact.contextRevision >= 0)) &&
          artifact.createdAt is string &&
          artifact.updatedAt is string;
      }

      function validCheck(check, checkId, checkName) {
        return check.keys().hasOnly([
            'id', 'name', 'required', 'status', 'evidence', 'history', 'revision', 'updatedAt'
          ]) &&
          check.keys().hasAll(['id', 'name', 'required', 'status', 'history', 'revision', 'updatedAt']) &&
          check.id == checkId &&
          check.name == checkName &&
          check.required == true &&
          check.status in ['pending', 'passed', 'failed'] &&
          check.history is list &&
          check.revision is int && check.revision >= 0 &&
          check.updatedAt is string &&
          ((!check.keys().hasAny(['evidence']) && check.status == 'pending') ||
            (check.keys().hasAny(['evidence']) && validEvidence(check.evidence) &&
              check.status == check.evidence.status));
      }

      function validReview(decision) {
        return decision.keys().hasOnly([
            'decision', 'reviewer', 'reason', 'returnStage', 'taskRevision', 'recordedAt'
          ]) &&
          decision.keys().hasAll(['decision', 'reviewer', 'taskRevision', 'recordedAt']) &&
          decision.decision in ['approved', 'changes-requested'] &&
          decision.reviewer.keys().hasOnly(['id', 'name', 'source']) &&
          decision.reviewer.keys().hasAll(['id', 'name', 'source']) &&
          decision.reviewer.id is string && decision.reviewer.id.size() > 0 &&
          decision.reviewer.id == request.auth.uid &&
          decision.reviewer.name is string && decision.reviewer.name.size() > 0 &&
          decision.reviewer.source == 'owner' &&
          decision.taskRevision is int && decision.taskRevision > 0 &&
          decision.recordedAt is string &&
          (decision.decision == 'approved' ||
            (decision.reason is string && decision.reason.size() > 0 &&
              decision.returnStage in ['discovery', 'planning', 'implementation', 'validation']));
      }

      function validTaskEnvelope(task, taskId) {
        return task.keys().hasOnly([
          'id', 'title', 'goal', 'stage', 'intentRevision', 'revision', 'workRevision',
            'persistenceRevision', 'artifacts', 'validationChecks', 'reviewDecisions',
            'contextEntries', 'contextRevision', 'createdAt', 'updatedAt'
          ]) &&
          task.keys().hasAll([
            'id', 'title', 'goal', 'stage', 'intentRevision', 'revision', 'workRevision',
            'artifacts', 'validationChecks', 'reviewDecisions', 'createdAt', 'updatedAt'
          ]) &&
          task.id == taskId &&
          task.title is string && task.title.size() > 0 &&
          task.goal is string && task.goal.size() > 0 &&
          task.stage in ['discovery', 'planning', 'implementation', 'validation', 'review', 'handoff'] &&
          task.intentRevision is int && task.intentRevision > 0 &&
          task.revision is int && task.revision > 0 &&
          task.workRevision is int && task.workRevision > 0 &&
          (!task.keys().hasAny(['persistenceRevision']) ||
            (task.persistenceRevision is int && task.persistenceRevision > 0)) &&
          task.createdAt is string &&
          task.updatedAt is string &&
          task.artifacts is map &&
          task.validationChecks is list && task.validationChecks.size() == 4 &&
          task.reviewDecisions is list && task.reviewDecisions.size() <= 100 &&
          // ponytail: rules cap context count; scanning long pasted strings exceeds the expression budget. Move contexts to per-entry docs if server-enforced text limits become necessary.
          (!task.keys().hasAny(['contextEntries']) ||
            (task.contextEntries is list && task.contextEntries.size() <= 5)) &&
          (!task.keys().hasAny(['contextRevision']) ||
            (task.contextRevision is int && task.contextRevision >= 0));
      }

      function validArtifacts(artifacts) {
        return artifacts.keys().hasOnly(['discovery', 'planning', 'implementation', 'review']) &&
          (!artifacts.keys().hasAny(['discovery']) || validArtifact(artifacts.discovery, 'discovery', 'discovery-notes')) &&
          (!artifacts.keys().hasAny(['planning']) || validArtifact(artifacts.planning, 'planning', 'plan')) &&
          (!artifacts.keys().hasAny(['implementation']) || validArtifact(artifacts.implementation, 'implementation', 'implementation-notes')) &&
          (!artifacts.keys().hasAny(['review']) || validArtifact(artifacts.review, 'review', 'review-notes'));
      }

      function validChecks(checks) {
        return checks.size() == 4 &&
          validCheck(checks[0], 'typecheck', 'Typecheck') &&
          validCheck(checks[1], 'lint', 'Lint') &&
          validCheck(checks[2], 'coverage', 'Coverage') &&
          validCheck(checks[3], 'build-performance', 'Build and performance');
      }

      function validReviews(decisions) {
        return decisions.size() <= 100 &&
          (decisions.size() == 0 || validReview(decisions[decisions.size() - 1]));
      }

      function validTask(task, taskId) {
        return validTaskEnvelope(task, taskId) &&
          task.keys().hasAll(['contextEntries', 'contextRevision']) &&
          task.contextEntries.size() == 0 &&
          task.contextRevision is int && task.contextRevision >= 0 &&
          validArtifacts(task.artifacts) &&
          validChecks(task.validationChecks) &&
          validReviews(task.reviewDecisions);
      }

      function validTaskUpdate(task, taskId) {
        return validTaskEnvelope(task, taskId) &&
          validReviews(task.reviewDecisions);
      }

      match /tasks/{taskId} {
        allow get, list: if isWorkspaceOwner();
        allow create: if isWorkspaceOwner() &&
          request.resource.data.persistenceRevision == 1 &&
          validTask(request.resource.data, taskId);
        allow update: if isWorkspaceOwner() &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.createdAt == resource.data.createdAt &&
          ((!resource.data.keys().hasAny(['persistenceRevision']) &&
              request.resource.data.persistenceRevision == 1) ||
            (resource.data.persistenceRevision is int &&
              request.resource.data.persistenceRevision == resource.data.persistenceRevision + 1)) &&
          validTaskUpdate(request.resource.data, taskId);
        allow delete: if false;
      }
    }

    match /users/{uid} {
      // A user can read and write only their own profile document
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      // Client can read (needed to check "am I admin") but never write —
      // admin docs are added manually via the Firebase console only.
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /photos/{photoId} {
      // Public read: the photobook is a shareable community gallery.
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.authorUid == request.auth.uid;
      // Broad update: other authenticated users increment commentCount
      // when they comment on someone else's photo.
      allow update: if request.auth != null;
      allow delete: if request.auth != null &&
        (resource.data.authorUid == request.auth.uid || isAdmin());

      match /reactions/{uid} {
        allow read: if true;
        // Doc id == uid enforces "one reaction per user" structurally.
        allow create, delete: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null &&
          request.resource.data.authorUid == request.auth.uid;
        // Broad update: other authenticated users increment reactionCount
        // when they react to someone else's comment.
        allow update: if request.auth != null;
        allow delete: if request.auth != null &&
          (resource.data.authorUid == request.auth.uid || isAdmin());

        match /reactions/{uid} {
          allow read: if true;
          // Doc id == uid enforces "one reaction per user" structurally.
          allow create, delete: if request.auth != null && request.auth.uid == uid;
          allow update: if false;
        }
      }
    }
  }
}
