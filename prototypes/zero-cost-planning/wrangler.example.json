{
  "name": "pd36-planning-spike",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "observability": { "enabled": false },
  "ai": { "binding": "AI" },
  "vars": {
    "FREE_PLAN_CONFIRMED": "false",
    "FIREBASE_PROJECT_ID": "REPLACE_WITH_EXISTING_TEST_PROJECT",
    "CLOUDFLARE_ACCOUNT_ID": "REPLACE_WITH_EXISTING_FREE_ACCOUNT",
    "BETA_UIDS": "REPLACE_WITH_UP_TO_FIVE_TEST_UIDS"
  },
  "d1_databases": [
    {
      "binding": "QUOTA",
      "database_name": "pd36-quota",
      "database_id": "REPLACE_WITH_APPROVED_TEST_DATABASE_ID"
    }
  ]
}
